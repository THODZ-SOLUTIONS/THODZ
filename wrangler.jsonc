{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "thodz",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    // Node.js APIs for the OpenNext server runtime.
    "nodejs_compat",
    // Allow outbound fetches (Supabase, Resend) from the worker.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Without this binding the OpenNext adapter answers /_next/image with the
  // ORIGINAL file (see @opennextjs/cloudflare templates/images.js), so every
  // case-study screenshot would ship at full size and next/image's srcset
  // would buy nothing. Requires Images to be enabled for the account.
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match "name" above.
      "service": "thodz"
    }
  ]
}
