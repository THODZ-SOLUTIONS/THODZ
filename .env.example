# Copy to .env.local for local development. None of these are required to run
# the site: without them the contact form logs instead of emailing, and the
# placeholder sections stay hidden.

# --- Contact form email delivery (Resend) ---------------------------------
# Without RESEND_API_KEY, submissions are logged server-side and no email is
# sent. See README.
RESEND_API_KEY=
CONTACT_TO_EMAIL=support@thodz.com
CONTACT_FROM_EMAIL=

# --- Placeholder preview --------------------------------------------------
# Set to 1 to render the sections that are waiting on real content
# (testimonials, client logos, engagement price floors) using clearly-marked
# sample data. Local development only. Never set this in production: the
# placeholder entries are visibly fake and would read as invented client
# endorsements if published.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=
